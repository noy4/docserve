{
  "name": "@noy4/docserve",
  "version": "0.3.2",
  "description": "Serves a folder of HTML as a card gallery with live reload.",
  "type": "module",
  "bin": {
    "docserve": "./bin.mjs"
  },
  "scripts": {
    "dev": "node bin.mjs ../docs/docs --port 4300 --open",
    "test": "node --test --test-timeout=60000",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "bin.mjs",
    "index.html",
    "src/"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "static-server",
    "live-reload",
    "gallery",
    "html"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy4/docserve.git"
  },
  "homepage": "https://github.com/noy4/docserve#readme",
  "bugs": "https://github.com/noy4/docserve/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
