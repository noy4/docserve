{
  "name": "@noy4/docserve",
  "version": "0.3.4",
  "description": "Serves a folder of HTML as a card gallery with live reload.",
  "type": "module",
  "bin": {
    "docserve": "./bin.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "npm run build && node --test --test-timeout=60000",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "files": [
    "bin.mjs",
    "index.html",
    "src/",
    "dist/widget/*.js"
  ],
  "devDependencies": {
    "@iconify/json": "^2.2.558",
    "@preact/signals-react": "^3.12.0",
    "@preact/signals-react-transform": "^0.8.3",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "static-server",
    "live-reload",
    "gallery",
    "html"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy4/docserve.git"
  },
  "homepage": "https://github.com/noy4/docserve#readme",
  "bugs": "https://github.com/noy4/docserve/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
