{
  "name": "docserve-desktop",
  "private": true,
  "version": "0.1.2",
  "description": "docserve desktop app",
  "author": "noy4",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:dir": "electron-builder --mac dir"
  },
  "build": {
    "appId": "dev.docserve.desktop",
    "productName": "Docserve",
    "afterPack": "scripts/adhoc-sign.mjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../cli",
        "to": "cli"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
